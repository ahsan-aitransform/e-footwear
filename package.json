{
  "name": "e-footwear",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run generate:shell && node scripts/writeBuildTsconfig.mjs",
    "dev": "next dev",
    "prebuild": "npm run generate:shell && npm run contracts:generate -- --check && node scripts/writeBuildTsconfig.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components features lib scripts tests",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "contracts:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generatePermissionCodes.mjs",
    "generate:shell": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generateServiceWorkerShell.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
